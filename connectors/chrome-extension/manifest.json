{
  "manifest_version": 3,
  "name": "Breadcrumbs Connector",
  "version": "0.1.0",
  "description": "Sends sanitized browser-app activity to the local Breadcrumbs API and applies approved edits.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://mail.google.com/*",
    "https://*.slack.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*", "https://*.slack.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Breadcrumbs"
  }
}
